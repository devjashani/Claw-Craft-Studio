# ==============================================================================
# CLAWCRAFT PRODUCTION / LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# SITE & PUBLIC CONFIGURATION
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="CLAWCRAFT"

# SUPABASE (Client & Server)
# Create a Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only service role key (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# RAZORPAY PAYMENTS (Test or Live)
# Get from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholderKeyId"
RAZORPAY_KEY_SECRET="placeholderSecret"
RAZORPAY_WEBHOOK_SECRET="placeholderWebhookSecret"

# RESEND TRANSACTIONAL EMAILS
# Get from https://resend.com/api-keys
RESEND_API_KEY="re_placeholderKey"
EMAIL_FROM="orders@clawcraft.in"
ADMIN_NOTIFICATION_EMAIL="studio@clawcraft.in"

# CLOUDINARY MEDIA STORAGE & CDN
# Get from Cloudinary Dashboard (https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Or single connection URL:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# SOCIAL & CONTACT
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210" # Indian mobile number without +
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/clawcraft.art"

# E-COMMERCE CONFIGURATION & FEATURE FLAGS
ENABLE_COD="false"
DEFAULT_SHIPPING_FEE_PAISE="14900" # Flat Rs 149
FREE_SHIPPING_THRESHOLD_PAISE="299900" # Free shipping for orders above Rs 2,999
